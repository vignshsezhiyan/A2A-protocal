# Copy to .env for local runs. NEVER commit .env.

# LLM (OpenAI-compatible)
LLM_BASE_URL=
LLM_MODEL=gpt-oss-120b
LLM_API_KEY=

# Callers must send this in the X-API-Key header. Empty = no auth (local dev only).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
A2A_API_KEY=

# Optional: public URL advertised in the Agent Card. On Render, RENDER_EXTERNAL_URL is used automatically.
# A2A_PUBLIC_URL=http://127.0.0.1:10010
# PORT=10010
